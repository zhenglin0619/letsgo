# Copy this file to .env.local and fill in your own values.
# All variables are NEXT_PUBLIC_*, so they are embedded in the client bundle
# at build time — never put server-only secrets here.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps JavaScript API key (restrict it to your domains via HTTP referrers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# CARTO Basemaps key (optional; tiles load without a key for light usage)
NEXT_PUBLIC_CARTO_API_KEY=
